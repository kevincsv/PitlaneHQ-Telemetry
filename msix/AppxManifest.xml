<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store version of Pitlane HQ (MSIX). windows.yml fills the __NAME__, __PUBLISHER__,
     __PUBLISHER_NAME__ and __VERSION__ marks from the secrets STORE_IDENTITY_NAME, STORE_PUBLISHER and
     STORE_PUBLISHER_NAME (Partner Center → the app → Product identity) and main.go's appVersion. The Store signs it.
     The startup task's TaskId is Store.TaskId (desktop/PitlaneHQ.Desktop/Store.cs). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="__NAME__" Publisher="__PUBLISHER__" Version="__VERSION__" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Pitlane HQ</DisplayName>
    <PublisherDisplayName>__PUBLISHER_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es-es" />
    <Resource Language="pt-br" />
  </Resources>

  <Applications>
    <Application Id="PitlaneHQ" Executable="PitlaneHQ.Desktop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Pitlane HQ" Description="Pitlane HQ" BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- "Start with Windows": off until the driver turns it on (the window follows the setting, Store.cs) -->
        <desktop:Extension Category="windows.startupTask" Executable="PitlaneHQ.Desktop.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="PitlaneHQStartup" Enabled="false" DisplayName="Pitlane HQ" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <!-- voice chat -->
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
