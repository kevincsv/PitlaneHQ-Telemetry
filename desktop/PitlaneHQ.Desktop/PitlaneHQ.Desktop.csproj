<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- the Windows 10 SDK's types: the Microsoft Store version's startup task (Store.cs) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- the icon in the notification area (Tray.cs, NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- the DPI awareness stays in app.manifest, where WPF reads it -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PitlaneHQ.Desktop</AssemblyName>
    <RootNamespace>PitlaneHQ.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\pitlanehq.ico</ApplicationIcon>
    <Version>0.5.2</Version>
    <Company>Pitlane HQ</Company>
    <Product>Pitlane HQ</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- a tidy install folder: the window, the .NET runtime and its libraries in one compressed PitlaneHQ.Desktop.exe;
         only the native files WPF and WebView2 load sit beside it (not extracted to %TEMP%, so the updater's zip
         overwrites them with the matching version). Old loose files: oldlayout.go and the .iss's [InstallDelete] -->
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!-- WebView2Loader.dll once, next to the window (MainWindow sets the loader's folder), not again in runtimes\ -->
    <WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>
  </PropertyGroup>

  <!-- the app's fonts, the same files the native overlays draw with -->
  <ItemGroup>
    <Resource Include="..\..\ovfonts\*.ttf" Link="fonts\%(Filename)%(Extension)" />
    <!-- the logo in the header, rendered from assets/logo.svg -->
    <Resource Include="img\logo.png" />
  </ItemGroup>

  <!-- WPF's names stay the plain ones: Windows Forms only by its full name (Tray.cs) -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- the notification area's icon, the app's own -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\pitlanehq.ico" LogicalName="pitlanehq.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

</Project>
